# Copy this file to .env and fill in real values. Never commit the real .env.

# Shared secret that the ASP.NET Core backend must send as X-Service-Api-Key
SERVICE_API_KEY=uzpAY4PsFI1HofvRx9tc3gGC7whOBSWUXidb0VNT

# Google AI Studio (https://aistudio.google.com) — despite the "OPENROUTER_"
# prefix (kept for generality — this client works with any OpenAI-compatible
# endpoint), production points directly at Gemini's OpenAI-compatibility layer.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Locked decision (revised) — do not change without re-running the accuracy
# comparison. Must always be a vision-capable model: every /analyze call sends
# an image, and a text-only model fails every request.
OPENROUTER_MODEL=gemini-3.6-flash
OPENROUTER_SITE_URL=https://medicare.app
OPENROUTER_SITE_NAME=MediCare

# Confidence weighting — must sum to 1.0
WEIGHT_OCR=0.4
WEIGHT_LLM=0.4
WEIGHT_DB_MATCH=0.2

# Thresholds
REVIEW_CONFIDENCE_THRESHOLD=0.90
IMAGE_QUALITY_REJECT_THRESHOLD=0.50

# Upload limits
MAX_IMAGE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
